FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y tesseract-ocr tesseract-ocr-mal curl && rm -rf /var/lib/apt/lists/*

COPY packages/ /app/packages/
COPY apps/api-gateway/ /app/apps/api-gateway/
COPY data/ /app/data/
COPY evaluation/ /app/evaluation/

RUN pip install --no-cache-dir fastapi uvicorn pydantic requests google-generativeai

EXPOSE 8000

CMD ["uvicorn", "apps.api-gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
